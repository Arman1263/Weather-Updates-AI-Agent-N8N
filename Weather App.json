    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.message.text }}",
        "options": {
          "systemMessage": "You are a helpful weather assistant.\n\nWhen the user asks for weather:\n1. Identify the location from the user's message. If the user does not name a location but a location was used earlier in the conversation, reuse that most recent location.\n2. Use the location search tool to find its latitude and longitude.\n3. Use the weather API tool with those coordinates. This tool returns BOTH current conditions and a daily forecast for today and the next several days.\n4. Answer using the returned data: for \"now\"/\"current\" use the current block; for \"today\", \"tomorrow\", or a specific upcoming day, use the matching entry from the daily forecast block (the daily.time array lists the dates).\n5. Never invent weather information. If a requested day is beyond the forecast range, say so.\n6. Keep the response concise, clear, and useful.\n7. Explain weather codes in simple language when relevant.\n\nIf the user does not specify a location and none was mentioned earlier, ask them which location they want.\n\nFORMATTING: The reply is sent to Telegram with HTML parse mode. Format your answer using ONLY Telegram-supported HTML tags: <b>bold</b>, <i>italic</i>, <code>code</code>. Do NOT use Markdown (no ** or * characters) and do NOT use bullet characters like *. For lists, put each item on its own line with a leading \"- \". Never emit unescaped <, > or & characters other than in the allowed tags."
        }
      },
      "id": "0a4dfb87-09e9-4198-af12-8b6df342d0e9",
      "name": "AI Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        672,
        0
      ]
    },
    {
      "parameters": {
        "modelName": "models/gemini-3.6-flash",
        "options": {}
      },
      "id": "d3098306-c1a3-413f-9287-faf13f1bf46c",
      "name": "Google Gemini Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1.1,
      "position": [
        544,
        208
      ],
      "retryOnFail": true,
      "credentials": {
        "googlePalmApi": {
          "id": "5jNZUeyoCsDOcHT9",
          "name": "Google Gemini(PaLM) Api account 3"
        }
      }
    },
    {
      "parameters": {
        "sessionIdType": "customKey",
        "sessionKey": "={{ $('Telegram Trigger').item.json.message.chat.id }}"
      },
      "id": "fdf48075-e996-4fe9-beec-89689273d3e3",
      "name": "Simple Memory",
      "type": "@n8n/n8n-nodes-langchain.memoryBufferWindow",
