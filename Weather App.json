    {
      "parameters": {
        "toolDescription": "Search for the latitude and longitude of a city or location.\nUse this tool whenever the user asks for weather for a specific location.",
        "url": "https://geocoding-api.open-meteo.com/v1/search",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "name",
              "value": "={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('parameters0_Value', ``, 'string') }}"
            },
            {
              "name": "count",
              "value": "1"
            },
            {
              "name": "language",
              "value": "en"
            },
            {
              "name": "format",
              "value": "json"
            }
          ]
        },
        "options": {}
      },
      "id": "6d3e2ff5-751b-4107-b855-3ede231ffecb",
      "name": "HTTP Request",
      "type": "n8n-nodes-base.httpRequestTool",
      "typeVersion": 4.5,
      "position": [
        992,
        240
      ]
    },
    {
      "parameters": {
        "toolDescription": "Get the weather for a location using its latitude and longitude. Returns BOTH the current conditions AND a multi-day daily forecast (today plus the next 6 days), so it answers questions about now, today, tomorrow, and upcoming days.\nUse this tool after finding the coordinates of the requested location.",
        "url": "https://api.open-meteo.com/v1/forecast",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "latitude",
              "value": "={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('parameters0_Value', `The latitude of the location returned by the geocoding tool.`, 'string') }}"
            },
            {
              "name": "longitude",
              "value": "={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('parameters1_Value', `The longitude of the location returned by the geocoding tool.`, 'string') }}"
            },
            {
              "name": "current",
              "value": "temperature_2m,relative_humidity_2m,apparent_temperature,precipitation,weather_code,wind_speed_10m"
            },
            {
              "name": "daily",
              "value": "weather_code,temperature_2m_max,temperature_2m_min,apparent_temperature_max,apparent_temperature_min,precipitation_sum,precipitation_probability_max,wind_speed_10m_max"
            },
            {
              "name": "forecast_days",
              "value": "7"
            },
            {
              "name": "timezone",
              "value": "auto"
            }
          ]
        },
        "options": {}
      },
      "id": "378d56b6-3545-40a9-84f5-68b016aa7584",
      "name": "HTTP Request1",
      "type": "n8n-nodes-base.httpRequestTool",
      "typeVersion": 4.5,
      "position": [
        816,
        256
      ]
    },
